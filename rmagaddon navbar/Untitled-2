<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Responsive Navbar - Untitled-2</title>
    <!-- Styles & script are stored in the file named `Untitled-1` in this workspace. -->
    <!-- If your browser doesn't load that file directly, copy the CSS from `Untitled-1` into a <style> block and the JS into a <script> block. -->
  </head>
  <body>
    <div class="bg-svg" aria-hidden="true">
      <!-- decorative svg background (uses CSS variable --bg-svg-fill) -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="800" height="600" fill="transparent"></rect>
        <circle cx="650" cy="120" r="220" fill="var(--bg-svg-fill)" opacity="0.12"></circle>
        <rect x="300" y="350" width="500" height="300" rx="120" fill="var(--bg-svg-fill)" opacity="0.08"></rect>
      </svg>
    </div>

    <nav class="nav">
      <div class="brand">My Site</div>

      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
        <span class="hamburger" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>

      <ul class="nav-menu" id="nav-menu">
        <li><a href="#" data-page="home">Home</a></li>
        <li><a href="#" data-page="about">About</a></li>
        <li><a href="#" data-page="events">Events</a></li>
        <li><a href="#" data-page="services">Services</a></li>
        <li><a href="#" data-page="contact">Contact</a></li>
      </ul>
    </nav>

    <!-- If your environment can load a local file named `Untitled-1` as CSS/JS, you may reference it; otherwise copy the relevant sections from `Untitled-1` into this file for quick testing. -->

    <!-- Load the JS that controls the nav and theme behavior -->
    <script src="Untitled-1.js" defer></script>
  </body>
</html>