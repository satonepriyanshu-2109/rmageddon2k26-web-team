/* ----------------- CSS (copy to a .css file or use as-is) ----------------- */
:root{ --nav-bg:#333; --nav-color:#fff; --accent:#ffce00; --bg-svg-fill:#0ea5e9 }
*{box-sizing:border-box}
body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;margin:0}
.nav{
  display:flex;align-items:center;justify-content:space-between;padding:.6rem 1rem;background:var(--nav-bg);color:var(--nav-color);position:relative
}
.brand{font-weight:700}
.nav-menu{list-style:none;margin:0;padding:0;display:flex;gap:1rem}
.nav-menu a{color:var(--nav-color);text-decoration:none;padding:.4rem .6rem;border-radius:4px}
.nav-menu a:hover{background:rgba(255,255,255,.05)}

/* screen-reader only */
.sr-only{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}

/* hamburger */
.nav-toggle{display:none;background:none;border:0;padding:.25rem;cursor:pointer;color:inherit}
.hamburger{width:22px;height:2px;background:var(--nav-color);position:relative;display:inline-block;transition:background .2s}
.hamburger::before,.hamburger::after{content:"";position:absolute;left:0;width:22px;height:2px;background:var(--nav-color);transition:transform .2s,top .2s}
.hamburger::before{top:-7px}
.hamburger::after{top:7px}

/* responsive: collapse at 768px */
@media (max-width:768px){
  .nav-toggle{display:inline-block}
  .nav-menu{position:absolute;top:60px;right:1rem;background:var(--nav-bg);flex-direction:column;gap:0;width:220px;display:none;border-radius:6px;padding:.25rem 0;box-shadow:0 6px 18px rgba(0,0,0,.12)}
  .nav-menu li{padding:0}
  .nav-menu li + li{border-top:1px solid rgba(255,255,255,.04)}
  .nav-menu.active{display:flex}
  /* transform hamburger into X when menu open */
  .nav-toggle[aria-expanded="true"] .hamburger{background:transparent}
  .nav-toggle[aria-expanded="true"] .hamburger::before{transform:rotate(45deg);top:0}
  .nav-toggle[aria-expanded="true"] .hamburger::after{transform:rotate(-45deg);top:0}
}

/* background svg (positioned behind content) */
.bg-svg{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden}
.bg-svg svg{width:120%;height:120%;min-width:600px;min-height:400px;display:block;transform:translate(-10%,-10%)}
.bg-svg circle,.bg-svg rect{transition:fill .25s,opacity .25s}

/* theme: red (applies to document root when viewing Events) */
.theme-red{ --bg-svg-fill:#ef4444; --nav-bg:#7b1f1f; --accent:#ffb4b4 }

